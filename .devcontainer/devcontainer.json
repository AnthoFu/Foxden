{
  "name": "Foxden - Minecraft Server Manager",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "latest",
      "additionalVersions": "17,21,25"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [8000, 25565],
  "portsAttributes": {
    "8000": {
      "label": "Foxden Dashboard",
      "onAutoForward": "openBrowser"
    },
    "25565": {
      "label": "Minecraft Internal Port",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
